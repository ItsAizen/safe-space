---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LiveCounter from '../components/LiveCounter.astro';
import '../styles/global.css';
---

<Layout>
  <div id="pin-lock" class="fixed inset-0 z-50 flex flex-col items-center justify-center pointer-events-auto">
    <div class="absolute inset-0 bg-surface-dark/95 backdrop-blur-2xl"></div>
    <div class="relative z-10 flex flex-col items-center px-8 w-full max-w-[340px]">
      <div id="pin-icon" class="mb-8 w-14 h-14 rounded-2xl bg-emerald-600/10 border border-emerald-600/20 flex items-center justify-center">
        <svg class="w-6 h-6 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-white/95 mb-2 tracking-tight">Safe Space</h1>
      <p class="text-sm text-white/40 mb-10">ورود به فضای اختصاصی</p>
      <div id="pin-dots" class="flex items-center gap-4 mb-8">
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
      </div>
      <div dir="ltr" class="grid grid-cols-4 gap-1">
        <button type="button" data-digit="1" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">1</button>
        <button type="button" data-digit="2" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">2</button>
        <button type="button" data-digit="3" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">3</button>
        <button type="button" data-digit="4" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">4</button>
        <button type="button" data-digit="5" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">5</button>
        <button type="button" data-digit="6" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">6</button>
        <button type="button" data-digit="7" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">7</button>
        <button type="button" data-digit="8" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">8</button>
        <button type="button" data-digit="9" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">9</button>
        <div class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95"></div>
        <button type="button" data-digit="0" class="pin-key h-12 rounded-lg bg-white/[0.06] border border-white/[0.08] text-white/90 text-sm font-medium transition-all duration-150 active:scale-95">0</button>
        <button type="button" data-action="delete" class="pin-key h-12 rounded-lg bg-transparent border border-white/20 text-white/40 flex items-center justify-center transition-all duration-150 active:scale-95">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
      <p id="pin-error" class="mt-4 text-sm text-red-400 opacity-0 transition-opacity duration-300 text-center">رمز عبور اشتباه است</p>
    </div>
  </div>

  <div id="app-content" class="flex flex-col min-h-dvh overflow-hidden" style="opacity:0;pointer-events:none;">

    <header class="sticky top-0 z-30 backdrop-blur-xl bg-surface-dark/70 border-b border-white/[0.06]">
      <div class="flex items-center justify-between px-4 h-14">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-emerald-600/10 border border-emerald-600/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>
          <div>
            <h1 class="text-sm font-bold text-white/90 leading-none">Safe Space</h1>
            <p class="text-[10px] text-white/30 mt-0.5">مهرداد و سوگل</p>
          </div>
        </div>
        <ThemeToggle />
      </div>
    </header>

    <main class="flex-1 px-4 pt-4 pb-16 overflow-y-auto">
      <LiveCounter />
      <section class="mt-6">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-1 h-4 rounded-full bg-emerald-600/60"></div>
          <h2 class="text-sm font-medium text-white/50 tracking-wide">تیم‌لاین خاطرات</h2>
          <div class="flex-1 h-px bg-white/[0.06]"></div>
        </div>
        <div class="relative">
          <div class="timeline-line absolute left-1/2 top-0 bottom-0 transform -translate-x-1/2 w-px bg-emerald-600/50"></div>
          <div id="timeline-list" class="relative space-y-4"></div>
          <div id="timeline-empty" class="absolute inset-0 flex items-center justify-center text-white/30 text-center">
            <div class="text-[12px]">هنوز خاطره‌ای ثبت نشده</div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <button id="fab-add" type="button" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30 btn-primary flex items-center gap-2 text-sm font-bold rounded-full px-5 py-3 shadow-lg safe-bottom" style="background:linear-gradient(135deg, #10b981, #059669);">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    <span>ثبت خاطره</span>
  </button>

  <div id="drawer-overlay" class="overlay opacity-0 pointer-events-none z-40 transition-opacity duration-300" style="background:rgba(0,0,0,0.5);"></div>
  <div id="memory-drawer" class="fixed inset-x-0 bottom-0 z-50 translate-y-full transition-transform duration-400 ease-out" style="box-shadow:0 -8px 40px rgba(0,0,0,0.4); background:rgba(17,24,39,0.8);">
    <div class="relative bg-surface-dark-elevated rounded-t-2xl border-t border-white/[0.06] max-h-[85dvh] overflow-hidden">
      <div class="flex justify-center pt-2 pb-1 cursor-grab active:cursor-grabbing" id="drawer-handle"><div class="w-8 h-1 rounded-full bg-white/15"></div></div>
      <div class="flex items-center justify-between px-5 pb-4 border-b border-white/[0.06]">
        <h3 class="text-base font-bold text-white/90"> ثبت خاطره جدید</h3>
        <button id="drawer-close" type="button" class="btn-ghost w-8 h-8 flex items-center justify-center rounded-lg p-0"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
      </div>
      <form id="memory-form" class="p-5 space-y-4 resize-none">
        <div><label class="text-[10px] font-medium text-white/35 block tracking-wider">عنوان</label><input type="text" name="title" required class="input-field w-full rounded-lg bg-white/[0.04] border border-white/[0.06] text-white py-2.5 placeholder-text-white/40" placeholder="عنوان خاطره..." maxlength="120" /></div>
        <div><label class="text-[10px] font-medium text-white/35 block tracking-wider">توضیحات</label><textarea name="description" rows="2" class="input-field w-full rounded-lg bg-white/[0.04] border border-white/[0.06] text-white py-1.5 resize-none placeholder-text-white/40" maxlength="1000"></textarea></div>
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><label class="text-[10px] font-medium text-white/35 block tracking-wider">تاریخ</label><input type="date" name="date" class="input-field rounded-lg bg-white/[0.04] border border-white/[0.06] text-white py-2.5" /></div>
          <div><label class="text-[10px] font-medium text-white/35 block tracking-wider">ساعت</label><input type="time" name="time" class="input-field rounded-lg bg-white/[0.04] border border-white/[0.06] text-white py-2.5" /></div>
        </div>
        <div><label class="text-[10px] font-medium text-white/35 block tracking-wider">آهنگ (اختیاری)</label><input type="text" name="song" class="input-field w-full rounded-lg bg-white/[0.04] border border-white/[0.06] text-white py-2.5 placeholder-text-white/40" placeholder="نام آهنگ..." /></div>
        <div class="space-y-2">
          <label class="text-[10px] font-medium text-white/35 block tracking-wider">حالت مهرداد</label>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-mood="mehrdad" data-value="😎" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">😎 ریلکس</button>
            <button type="button" data-mood="mehrdad" data-value="🤯" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">🤯 پشم‌ریزون</button>
            <button type="button" data-mood="mehrdad" data-value="🔥" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">🔥 حال خوب</button>
          </div>
        </div>
        <div class="space-y-2">
          <label class="text-[10px] font-medium text-white/35 block tracking-wider">حالت سوگل</label>
          <div class="flex flex-wrap gap-1.5">
            <button type="button" data-mood="sogol" data-value="🐺" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">🐺 گرگی</button>
            <button type="button" data-mood="sogol" data-value="🥺" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">🥺 مظلوم</button>
            <button type="button" data-mood="sogol" data-value="😂" class="chip inline-flex items-center gap-1 px-2 py-1 rounded text-[9px] bg-emerald-600/10 border border-emerald-600/20 text-emerald-400 hover:bg-emerald-600/20">😂 خنده‌دار</button>
          </div>
        </div>
        <div>
          <label class="text-[10px] font-medium text-white/35 block tracking-wider">ثبت توسط</label>
          <div class="flex gap-2">
            <label class="flex-1 relative cursor-pointer py-2 rounded-xl border border-white/[0.06] bg-white/[0.02] text-sm font-medium text-white/50 hover:bg-white/[0.04]"><input type="radio" name="author" value="mehrdad" class="peer sr-only" checked /><span>مهرداد</span></label>
            <label class="flex-1 relative cursor-pointer py-2 rounded-xl border border-white/[0.06] bg-white/[0.02] text-sm font-medium text-white/50 hover:bg-white/[0.04]"><input type="radio" name="author" value="sogol" class="peer sr-only" /><span>سوگل</span></label>
          </div>
        </div>
        <div class="pt-3 border-t border-white/[0.06]">
          <button type="submit" class="w-full bg-gradient-to-r from-emerald-600 to-emerald-500 text-white py-2.5 rounded-lg font-medium text-sm transition-colors"> ثبت خاطره</button>
        </div>
      </form>
    </div>
  </div>

  <div id="toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 opacity-0 transition-opacity duration-300"><span>❤️</span> خاطره ثبت شد</div>

  <script is:inline src="/scripts/app.js"></script>
</Layout>