---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LiveCounter from '../components/LiveCounter.astro';
import '../styles/global.css';
---

<Layout>
  <!-- PIN LOCK -->
  <div id="pin-lock" class="fixed inset-0 z-50 flex flex-col items-center justify-center">
    <div class="absolute inset-0 bg-surface-dark/95 backdrop-blur-2xl"></div>
    <div class="relative z-10 flex flex-col items-center px-8 w-full max-w-[340px]">
      <div class="mb-8 w-14 h-14 rounded-2xl bg-neon-emerald/10 border border-neon-emerald/20 flex items-center justify-center">
        <svg class="w-6 h-6 text-neon-emerald" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </div>
      <h1 class="text-2xl font-bold text-white/95 mb-2 tracking-tight">Safe Space</h1>
      <p class="text-sm text-white/40 mb-10">ورود به فضای اختصاصی</p>
      <div id="pin-dots" class="flex items-center gap-4 mb-8">
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
        <div class="pin-dot w-3 h-3 rounded-full border-2 border-white/20 transition-all duration-300"></div>
      </div>
      <div dir="ltr" class="grid grid-cols-3 gap-3 w-full max-w-[260px]">
        <button type="button" data-digit="1" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">1</button>
        <button type="button" data-digit="2" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">2</button>
        <button type="button" data-digit="3" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">3</button>
        <button type="button" data-digit="4" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">4</button>
        <button type="button" data-digit="5" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">5</button>
        <button type="button" data-digit="6" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">6</button>
        <button type="button" data-digit="7" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">7</button>
        <button type="button" data-digit="8" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">8</button>
        <button type="button" data-digit="9" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">9</button>
        <div></div>
        <button type="button" data-digit="0" class="pin-key h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] text-white/90 text-lg font-medium active:scale-95 transition-transform duration-100">0</button>
        <button type="button" data-action="delete" class="pin-key h-14 rounded-2xl bg-transparent border border-white/10 text-white/40 flex items-center justify-center active:scale-95 transition-transform duration-100">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"/><line x1="18" y1="9" x2="12" y2="15"/><line x1="12" y1="9" x2="18" y2="15"/></svg>
        </button>
      </div>
      <p id="pin-error" class="mt-6 text-sm text-red-400 opacity-0 transition-opacity duration-300 text-center">رمز عبور اشتباه است</p>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="app-content" class="flex flex-col min-h-dvh" style="opacity:0;pointer-events:none;">

    <header class="app-header sticky top-0 z-30 backdrop-blur-xl border-b">
      <div class="flex items-center justify-between px-4 h-14">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-neon-emerald/10 border border-neon-emerald/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-neon-emerald" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          </div>
          <div>
            <h1 class="app-header-title text-sm font-bold leading-none">Safe Space</h1>
            <p class="app-header-sub text-[10px] mt-0.5">مهرداد و سوگل</p>
          </div>
        </div>
        <ThemeToggle />
      </div>
    </header>

    <main class="flex-1 px-4 pt-4 pb-24 overflow-y-auto">
      <LiveCounter />

      <section class="mt-6">
        <div class="flex items-center gap-2 mb-6">
          <div class="w-1 h-4 rounded-full bg-neon-emerald/60"></div>
          <h2 class="text-sm font-medium text-white/50 tracking-wide">تایم‌لاین خاطرات</h2>
          <div class="flex-1 h-px bg-white/[0.06]"></div>
        </div>

        <div class="relative">
          <div class="timeline-line"></div>
          <div id="timeline-list" class="relative space-y-5"></div>
          <div id="timeline-empty" class="relative py-20 text-center" style="display:none">
            <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-glass-border flex items-center justify-center mx-auto mb-4" style="box-shadow:0 8px 24px rgba(0,0,0,0.2);">
              <svg class="w-6 h-6 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <p class="text-sm text-white/30">هنوز خاطره‌ای ثبت نشده</p>
            <p class="text-xs text-white/15 mt-1.5">اولین خاطره‌تون رو ثبت کنید</p>
          </div>
        </div>
      </section>
    </main>

    <!-- FAB - INSIDE app-content -->
    <button id="fab-add" type="button" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30 flex items-center gap-2 text-sm font-bold text-white rounded-full px-6 py-3.5 shadow-glow-md active:scale-95 transition-transform duration-100 safe-bottom" style="background:linear-gradient(135deg, #10b981, #059669);border-radius:9999px;">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <span>ثبت خاطره</span>
    </button>
  </div>

  <!-- DRAWER OVERLAY -->
  <div id="drawer-overlay" class="overlay" style="opacity:0;pointer-events:none;z-index:40;"></div>

  <!-- DRAWER -->
  <div id="memory-drawer" class="fixed inset-x-0 bottom-0 z-50 translate-y-full" style="transition:transform 0.4s cubic-bezier(0.32,0.72,0,1);">
    <div class="bg-surface-dark-elevated rounded-t-3xl border-t border-glass-border max-h-[85dvh] flex flex-col overflow-hidden" style="box-shadow:0 -8px 40px rgba(0,0,0,0.5);">
      <div class="flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing" id="drawer-handle">
        <div class="w-10 h-1 rounded-full bg-white/15"></div>
      </div>
      <div class="flex items-center justify-between px-6 pb-4 border-b border-white/[0.06]">
        <h3 class="text-base font-bold text-white/90">ثبت خاطره جدید</h3>
        <button id="drawer-close" type="button" class="btn-ghost w-8 h-8 flex items-center justify-center p-0 rounded-lg">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <form id="memory-form" class="flex-1 overflow-y-auto px-6 py-5 space-y-5" style="-webkit-overflow-scrolling:touch;">
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-1.5 block tracking-wider">عنوان</label>
          <input type="text" name="title" required placeholder="عنوان خاطره..." class="input-field" maxlength="120" />
        </div>
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-1.5 block tracking-wider">توضیحات</label>
          <textarea name="description" rows="3" placeholder="درباره این خاطره..." class="input-field resize-none" maxlength="1000"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="text-[11px] font-medium text-white/35 mb-1.5 block tracking-wider">تاریخ</label><input type="date" name="date" class="input-field text-sm" /></div>
          <div><label class="text-[11px] font-medium text-white/35 mb-1.5 block tracking-wider">ساعت</label><input type="time" name="time" class="input-field text-sm" /></div>
        </div>
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-1.5 block tracking-wider">آهنگ (اختیاری)</label>
          <input type="text" name="song" placeholder="نام آهنگ..." class="input-field" />
        </div>
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-2.5 block tracking-wider">حالت مهرداد</label>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-mood="mehrdad" data-value="😎 ریلکس / خفن" class="chip"><span>😎</span> ریلکس / خفن</button>
            <button type="button" data-mood="mehrdad" data-value="🫠 خسته" class="chip"><span>🫠</span> خسته</button>
            <button type="button" data-mood="mehrdad" data-value="🤯 پشم‌ریزون" class="chip"><span>🤯</span> پشم‌ریزون</button>
            <button type="button" data-mood="mehrdad" data-value="🍵 چای به دست" class="chip"><span>🍵</span> چای به دست</button>
            <button type="button" data-mood="mehrdad" data-value="🔥 حال خوب" class="chip"><span>🔥</span> حال خوب</button>
            <button type="button" data-mood="mehrdad" data-value="😴 خواب‌آلود" class="chip"><span>😴</span> خواب‌آلود</button>
          </div>
        </div>
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-2.5 block tracking-wider">حالت سوگل</label>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-mood="sogol" data-value="🐺 گرگی / مود" class="chip"><span>🐺</span> گرگی / مود</button>
            <button type="button" data-mood="sogol" data-value="🥺 مظلوم" class="chip"><span>🥺</span> مظلوم</button>
            <button type="button" data-mood="sogol" data-value="😂 در حال پاره شدن" class="chip"><span>😂</span> در حال پاره شدن</button>
            <button type="button" data-mood="sogol" data-value="🍧 شکر‌لازم" class="chip"><span>🍧</span> شکر‌لازم</button>
            <button type="button" data-mood="sogol" data-value="🌸 حال خوب" class="chip"><span>🌸</span> حال خوب</button>
            <button type="button" data-mood="sogol" data-value="☕ قهوه‌خور" class="chip"><span>☕</span> قهوه‌خور</button>
          </div>
        </div>
        <div>
          <label class="text-[11px] font-medium text-white/35 mb-2.5 block tracking-wider">ثبت توسط</label>
          <div class="flex gap-3">
            <label class="flex-1 relative cursor-pointer"><input type="radio" name="author" value="mehrdad" class="peer sr-only" checked /><div class="text-center py-3 rounded-xl border border-glass-border bg-white/[0.03] text-sm font-medium text-white/50 transition-all duration-200 peer-checked:border-neon-emerald/40 peer-checked:bg-neon-emerald/[0.08] peer-checked:text-neon-emerald hover:bg-white/[0.06]">مهرداد</div></label>
            <label class="flex-1 relative cursor-pointer"><input type="radio" name="author" value="sogol" class="peer sr-only" /><div class="text-center py-3 rounded-xl border border-glass-border bg-white/[0.03] text-sm font-medium text-white/50 transition-all duration-200 peer-checked:border-neon-emerald/40 peer-checked:bg-neon-emerald/[0.08] peer-checked:text-neon-emerald hover:bg-white/[0.06]">سوگل</div></label>
          </div>
        </div>
        <button type="submit" class="btn-primary w-full py-3.5 text-sm mt-2">ثبت خاطره</button>
        <div class="h-4"></div>
      </form>
    </div>
  </div>

  <!-- TOAST -->
  <div id="toast" class="toast"></div>

  <!-- SHAKE ANIMATION -->
  <style>
    @keyframes shakeX {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-10px); }
      40% { transform: translateX(10px); }
      60% { transform: translateX(-6px); }
      80% { transform: translateX(6px); }
    }
  </style>

  <script is:inline src="/scripts/app.js"></script>
</Layout>
