---
import Layout from '../layouts/Layout.astro';
import PinLock from '../components/PinLock.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LiveCounter from '../components/LiveCounter.astro';
import Timeline from '../components/Timeline.astro';
import AddMemoryModal from '../components/AddMemoryModal.astro';
import '../styles/global.css';
---

<Layout>
  <!-- PIN Lock Screen -->
  <PinLock />

  <!-- Main App Content (hidden until PIN unlock) -->
  <div id="app-content" class="flex flex-col min-h-dvh">
    <!-- Top Bar -->
    <header class="sticky top-0 z-30 backdrop-blur-xl bg-surface-dark/70 border-b border-glass-border">
      <div class="flex items-center justify-between px-5 h-14">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-neon-emerald/10 border border-neon-emerald/20 flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-neon-emerald" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
          </div>
          <div>
            <h1 class="text-sm font-bold text-white/90 leading-none">Safe Space</h1>
            <p class="text-[10px] text-white/30 mt-0.5">مهرداد و سوگل</p>
          </div>
        </div>
        <ThemeToggle />
      </div>
    </header>

    <!-- Main Scrollable Content -->
    <main class="flex-1 px-4 pt-5 pb-28">
      <!-- Live Counter -->
      <LiveCounter />

      <!-- Timeline -->
      <Timeline />
    </main>
  </div>

  <!-- Add Memory Drawer -->
  <AddMemoryModal />
</Layout>

<script is:inline>
(function() {
  const appContent = document.getElementById('app-content');
  appContent.style.opacity = '0';
  appContent.style.pointerEvents = 'none';

  function showApp() {
    appContent.style.opacity = '1';
    appContent.style.pointerEvents = 'auto';

    if (window.gsap) {
      gsap.from(appContent, {
        opacity: 0,
        y: 20,
        duration: 0.6,
        ease: 'power3.out',
      });
    }

    loadMemories();
  }

  // Check if already authenticated
  if (sessionStorage.getItem('ss-auth') === '1') {
    showApp();
  } else {
    window.addEventListener('pin-unlocked', showApp);
  }

  // Toast helper
  window.showToast = function(message, icon) {
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.innerHTML = `<span>${icon || '✨'}</span> ${message}`;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
  };

  // Load memories from API
  window.loadMemories = async function() {
    try {
      const res = await fetch('/api/memories');
      if (res.ok) {
        const memories = await res.json();
        if (window.renderTimeline) window.renderTimeline(memories);
      }
    } catch (err) {
      console.error('Failed to load memories:', err);
    }
  };

  // Light mode header override
  const style = document.createElement('style');
  style.textContent = `
    html.light header { background: rgba(250,250,249,0.8); border-color: rgba(0,0,0,0.06); }
    html.light header h1 { color: #1c1917; }
    html.light header p { color: rgba(0,0,0,0.35); }
  `;
  document.head.appendChild(style);
})();
</script>
