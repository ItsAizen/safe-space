---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';
---

<Layout title="در حال تعمیر | Safe Space">
  <header class="app-header sticky top-0 z-30 backdrop-blur-xl border-b">
    <div class="flex items-center justify-between px-4 h-14">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-neon-emerald/10 border border-neon-emerald/20 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-neon-emerald" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </div>
        <h1 class="app-header-title text-sm font-bold leading-none">Safe Space</h1>
      </div>
      <ThemeToggle />
    </div>
  </header>

  <main class="fix-screen">
    <div class="fix-card">
      <div class="fix-stage" aria-hidden="true">
        <div class="fix-zap fix-zap--a">💡</div>
        <div class="fix-zap fix-zap--b">🔧</div>
        <span class="fix-bin">🗑️</span>
        <span class="fix-spark">✨</span>
      </div>

      <div class="fix-badge"><span></span> در حال تعمیر</div>

      <p class="fix-msg">ایده جانک بود، مث تمام جانکا پرت شد سطل آشغال :)</p>

      <div class="fix-dots">
        <span></span><span></span><span></span>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .fix-screen {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .fix-card {
    width: 100%;
    max-width: 400px;
    border-radius: 28px;
    padding: 40px 26px 32px;
    text-align: center;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02) 60%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 16px 40px rgba(0, 0, 0, 0.16);
  }

  .fix-stage {
    position: relative;
    width: 112px;
    height: 112px;
    margin: 0 auto 22px;
  }
  .fix-bin {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 62px;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.35));
    animation: binJiggle 2.4s ease-in-out infinite;
  }
  @keyframes binJiggle {
    0%, 100% { transform: translate(-50%, -50%) rotate(0deg); }
    42% { transform: translate(-50%, -50%) rotate(-7deg); }
    44% { transform: translate(-50%, -50%) rotate(8deg); }
    46% { transform: translate(-50%, -50%) rotate(-5deg); }
    50% { transform: translate(-50%, -52%); }
  }

  .fix-zap {
    position: absolute;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .fix-zap--a {
    top: 2px;
    left: 18px;
    transform-origin: 70% 90%;
    animation: zapSpin 2.4s ease-in-out infinite;
  }
  .fix-zap--b {
    top: 44px;
    left: 6px;
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes zapSpin {
    0% { transform: rotate(0deg); opacity: 0; }
    18% { opacity: 1; transform: rotate(0deg); }
    55% { opacity: 1; }
    70% { transform: rotate(320deg); opacity: 0; }
    100% { transform: rotate(320deg); opacity: 0; }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  .fix-spark {
    position: absolute;
    right: 8px;
    bottom: 16px;
    font-size: 18px;
    animation: sparkBlink 1.2s ease-in-out infinite;
  }
  @keyframes sparkBlink {
    0%, 100% { opacity: 0.15; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  .fix-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #6ee7b7;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.28);
  }
  .fix-badge span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    animation: livePulse 1.6s ease-out infinite;
  }
  @keyframes livePulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
    70% { box-shadow: 0 0 0 9px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .fix-msg {
    margin: 18px 0 8px;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.92);
  }
  .fix-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 24px;
  }
  .fix-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.55);
    animation: dotBounce 1.2s ease-in-out infinite;
  }
  .fix-dots span:nth-child(2) { animation-delay: 0.15s; }
  .fix-dots span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes dotBounce {
    0%, 100% { transform: translateY(0); opacity: 0.4; }
    50% { transform: translateY(-6px); opacity: 1; }
  }

  /* Light mode */
  html.light .fix-card {
    background: linear-gradient(180deg, #ffffff, rgba(255, 255, 255, 0.65));
    border-color: rgba(0, 0, 0, 0.07);
    box-shadow: inset 0 1px 0 #fff,
                0 16px 40px rgba(0, 0, 0, 0.07);
  }
  html.light .fix-msg { color: #18181b; }
</style>