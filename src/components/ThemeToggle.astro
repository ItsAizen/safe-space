---
---

<button
  id="theme-toggle"
  class="btn btn-ghost relative p-2 rounded-xl focus-ring"
  aria-label="تغییر تم"
  aria-pressed="false"
  type="button"
>
  <span class="sr-only">تغییر بین حالت روز و شب</span>
  <svg class="sun-icon w-5 h-5 text-[var(--color-text-muted)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="transform: rotate(0deg) scale(1); opacity: 1;">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg class="moon-icon absolute top-2 left-2 w-5 h-5 text-[var(--color-accent)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="transform: rotate(-90deg) scale(0); opacity: 0;">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <div class="toggle-track absolute inset-2 bg-[var(--color-border)] rounded-[inherit] transition-all duration-500" aria-hidden="true">
    <div class="toggle-thumb absolute top-0.5 left-0.5 w-4 h-4 bg-[var(--color-accent)] rounded-full shadow-[0_2px_8px_rgba(16,185,129,0.4)] transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]" style="transform: translateX(0);" aria-hidden="true"></div>
  </div>
</button>

<script type="module" src="/scripts/theme-toggle.js"></script>

<style>
  #theme-toggle {
    width: 56px;
    height: 40px;
  }

  .toggle-track {
    width: 100%;
    height: 100%;
  }

  .toggle-thumb {
    width: 30px;
    height: 30px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sun-icon, .moon-icon, .toggle-thumb, .toggle-track {
      transition: none !important;
    }
  }
</style>