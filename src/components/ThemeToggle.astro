---
---

<button
  id="theme-toggle"
  type="button"
  class="btn-ghost relative w-10 h-10 flex items-center justify-center rounded-xl p-0"
  aria-label="تغییر تم"
>
  <!-- Sun icon -->
  <svg id="icon-sun" class="w-[18px] h-[18px] transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <!-- Moon icon -->
  <svg id="icon-moon" class="w-[18px] h-[18px] absolute transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script is:inline>
(function() {
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  const sunIcon = document.getElementById('icon-sun');
  const moonIcon = document.getElementById('icon-moon');

  function updateIcons() {
    const isDark = html.classList.contains('dark');
    if (isDark) {
      sunIcon.style.opacity = '0';
      sunIcon.style.transform = 'rotate(-90deg) scale(0.5)';
      moonIcon.style.opacity = '1';
      moonIcon.style.transform = 'rotate(0deg) scale(1)';
    } else {
      sunIcon.style.opacity = '1';
      sunIcon.style.transform = 'rotate(0deg) scale(1)';
      moonIcon.style.opacity = '0';
      moonIcon.style.transform = 'rotate(90deg) scale(0.5)';
    }
  }

  updateIcons();

  toggle.addEventListener('click', function() {
    const isDark = html.classList.contains('dark');
    if (isDark) {
      html.classList.remove('dark');
      html.classList.add('light');
      localStorage.setItem('ss-theme', 'light');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#fafaf9');
    } else {
      html.classList.remove('light');
      html.classList.add('dark');
      localStorage.setItem('ss-theme', 'dark');
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#090a0f');
    }
    updateIcons();

    // GSAP morph effect
    if (window.gsap) {
      const isDarkNow = html.classList.contains('dark');
      gsap.fromTo(toggle, {
        rotate: 0,
        scale: 0.8,
      }, {
        rotate: 360,
        scale: 1,
        duration: 0.5,
        ease: 'back.out(1.7)',
      });
    }
  });
})();
</script>
