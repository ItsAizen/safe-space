---
---
<section
  id="pin-lock"
  class="absolute inset-0 z-40 flex flex-col items-center justify-center px-8 safe-top safe-bottom"
  style="background: var(--color-canvas);"
>
  <div class="mb-10 text-center">
    <div
      class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-3xl border border-line"
      style="box-shadow: 0 0 40px var(--color-glow);"
    >
      <span class="text-3xl">🌿</span>
    </div>
    <h1 class="text-2xl font-bold text-ink">Safe Space</h1>
    <p class="mt-1 text-sm text-ink-soft">ورود به فضای اختصاصی</p>
  </div>

  <div class="mb-9 flex items-center gap-4" id="pin-dots">
    <span class="pin-dot"></span>
    <span class="pin-dot"></span>
    <span class="pin-dot"></span>
    <span class="pin-dot"></span>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <button class="pin-key" data-val="1">۱</button>
    <button class="pin-key" data-val="2">۲</button>
    <button class="pin-key" data-val="3">۳</button>
    <button class="pin-key" data-val="4">۴</button>
    <button class="pin-key" data-val="5">۵</button>
    <button class="pin-key" data-val="6">۶</button>
    <button class="pin-key" data-val="7">۷</button>
    <button class="pin-key" data-val="8">۸</button>
    <button class="pin-key" data-val="9">۹</button>
    <button class="pin-key" aria-label="delete" data-val="del">⌫</button>
    <button class="pin-key" data-val="0">۰</button>
    <button class="pin-key pointer-events-none opacity-0" tabindex="-1" aria-hidden="true">·</button>
  </div>

  <p class="mt-8 text-xs text-ink-soft">برای باز کردن، کد ۴ رقمی را وارد کن</p>
</section>

<script>
  import { initPinLock } from '../lib/pin';
  initPinLock();
</script>
