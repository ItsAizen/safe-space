---
const { onUnlock } = Astro.props;
---

<div id="pin-lock" class="fixed inset-0 z-50 flex items-center justify-center p-6 glass-lg" role="dialog" aria-modal="true" aria-labelledby="pin-title">
  <div class="w-full max-w-sm animate-slide-up">
    <div class="text-center mb-10">
      <h1 id="pin-title" class="text-display-lg font-bold text-[var(--color-text)] tracking-tight">Safe Space</h1>
      <p class="mt-3 text-body text-[var(--color-text-muted)]">ورود به فضای اختصاصی</p>
    </div>

    <div class="flex items-center justify-center gap-3 mb-10" role="img" aria-label="رمز عبور ۴ رقمی">
      <div class="pin-dot" data-index="0" aria-hidden="true"></div>
      <div class="pin-dot" data-index="1" aria-hidden="true"></div>
      <div class="pin-dot" data-index="2" aria-hidden="true"></div>
      <div class="pin-dot" data-index="3" aria-hidden="true"></div>
    </div>

    <div class="glass p-6 rounded-2xl mb-6" dir="ltr">
      <div class="grid grid-cols-3 gap-3 mb-3" role="group" aria-label="صفحه کلید اعداد">
        <button type="button" class="keypad-btn" data-key="1" aria-label="۱">1</button>
        <button type="button" class="keypad-btn" data-key="2" aria-label="۲">2</button>
        <button type="button" class="keypad-btn" data-key="3" aria-label="۳">3</button>
        <button type="button" class="keypad-btn" data-key="4" aria-label="۴">4</button>
        <button type="button" class="keypad-btn" data-key="5" aria-label="۵">5</button>
        <button type="button" class="keypad-btn" data-key="6" aria-label="۶">6</button>
        <button type="button" class="keypad-btn" data-key="7" aria-label="۷">7</button>
        <button type="button" class="keypad-btn" data-key="8" aria-label="۸">8</button>
        <button type="button" class="keypad-btn" data-key="9" aria-label="۹">9</button>
      </div>
      <div class="flex items-center justify-center gap-3">
        <button type="button" class="btn btn-ghost w-12 h-12 rounded-xl focus-ring" data-action="backspace" aria-label="حذف">
          <svg class="w-6 h-6 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 4H8l-7 8 7 8h13a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path>
            <line x1="18" y1="9" x2="12" y2="15"></line>
            <line x1="12" y1="9" x2="18" y2="15"></line>
          </svg>
        </button>
        <button type="button" class="keypad-btn zero" data-key="0" aria-label="۰" style="width: 100%; max-width: 80px;">0</button>
        <button type="button" class="btn btn-ghost w-12 h-12 rounded-xl focus-ring" data-action="clear" aria-label="پاک کردن">
          <svg class="w-6 h-6 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <p id="pin-error" class="sr-only" aria-live="polite"></p>
  </div>
</div>

<script type="module" src="/scripts/pin-lock.js"></script>

<style>
  @media (prefers-reduced-motion: reduce) {
    #pin-lock .max-w-sm {
      animation: none !important;
      transition: none !important;
    }
  }
</style>