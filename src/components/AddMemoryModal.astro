---
const MEHRDAD_MOODS = [
  { value: 'ریلکس / خفن', label: 'ریلکس / خفن', emoji: '😎' },
  { value: 'خسته', label: 'خسته', emoji: '🫠' },
  { value: 'پشم‌ریزون', label: 'پشم‌ریزون', emoji: '🤯' },
  { value: 'چای به دست', label: 'چای به دست', emoji: '🍵' },
];

const SOGOL_MOODS = [
  { value: 'گرگی / مود', label: 'گرگی / مود', emoji: '🐺' },
  { value: 'مظلوم', label: 'مظلوم', emoji: '🥺' },
  { value: 'در حال پاره شدن', label: 'در حال پاره شدن', emoji: '😂' },
  { value: 'شکر‌لازم', label: 'شکر‌لازم', emoji: '🍧' },
];
---

<div id="add-memory-modal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-drawer" role="document">
    <div class="modal-handle" aria-hidden="true"></div>

    <header class="px-6 py-4 border-b border-[var(--color-border)] flex items-center justify-between">
      <h2 id="modal-title" class="text-heading font-semibold text-[var(--color-text)]">ثبت خاطره جدید</h2>
      <button type="button" class="btn btn-ghost p-2 rounded-xl focus-ring" id="close-modal" aria-label="بستن">
        <svg class="w-5 h-5 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <form id="memory-form" class="flex-1 overflow-y-auto scrollbar-thin p-6 space-y-5" novalidate>
      <div>
        <label for="title" class="block text-body-sm font-medium text-[var(--color-text)] mb-2">عنوان خاطره</label>
        <input type="text" id="title" name="title" class="input-field" placeholder="مثل: اولین کوaffee صبحگاهی" required maxlength="60" autocomplete="off" />
      </div>

      <div>
        <label for="description" class="block text-body-sm font-medium text-[var(--color-text)] mb-2">توضیحات</label>
        <textarea id="description" name="description" class="input-field min-h-[100px] resize-y" placeholder="جزئیات خاطره را بنویسید..." required maxlength="500"></textarea>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="date" class="block text-body-sm font-medium text-[var(--color-text)] mb-2">تاریخ (شمسی)</label>
          <input type="text" id="date" name="date" class="input-field text-center" placeholder="۱۴۰۵/۰۶/۰۱" required maxlength="10" autocomplete="off" />
        </div>
        <div>
          <label for="time" class="block text-body-sm font-medium text-[var(--color-text)] mb-2">ساعت</label>
          <input type="time" id="time" name="time" class="input-field" required />
        </div>
      </div>

      <div>
        <label for="song" class="block text-body-sm font-medium text-[var(--color-text)] mb-2">آهنگ (اختیاری)</label>
        <input type="text" id="song" name="song" class="input-field" placeholder="مثل: حال نرم - امین تیجایی" maxlength="80" autocomplete="off" />
      </div>

      <fieldset>
        <legend class="text-body-sm font-medium text-[var(--color-text)] mb-3">خالق خاطره</legend>
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="author" value="mehrdad" class="sr-only peer" checked />
            <span class="author-chip glass px-4 py-2.5 rounded-xl border border-[var(--color-border)] text-body font-medium text-[var(--color-text-muted)] peer-checked:border-[var(--color-accent)] peer-checked:bg-[rgba(16,185,129,0.1)] peer-checked:text-[var(--color-accent)] peer-checked:shadow-[0_0_12px_rgba(16,185,129,0.2)] transition-all duration-300">مهرداد</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="author" value="sogol" class="sr-only peer" />
            <span class="author-chip glass px-4 py-2.5 rounded-xl border border-[var(--color-border)] text-body font-medium text-[var(--color-text-muted)] peer-checked:border-[var(--color-accent)] peer-checked:bg-[rgba(16,185,129,0.1)] peer-checked:text-[var(--color-accent)] peer-checked:shadow-[0_0_12px_rgba(16,185,129,0.2)] transition-all duration-300">سوگل</span>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-body-sm font-medium text-[var(--color-text)] mb-3">حالت مهرداد</legend>
        <div class="mood-grid" id="mood-mehrdad" role="radiogroup" aria-label="انتخاب حالت مهرداد">
          {MEHRDAD_MOODS.map(mood => (
            <button type="button" class="mood-chip" data-mood={mood.value} role="radio" aria-checked="false">
              <span class="emoji">{mood.emoji}</span>
              <span>{mood.label}</span>
            </button>
          ))}
        </div>
        <input type="hidden" name="moodMehrdad" id="mood-mehrdad-input" value={MEHRDAD_MOODS[0].value} />
      </fieldset>

      <fieldset>
        <legend class="text-body-sm font-medium text-[var(--color-text)] mb-3">حالت سوگل</legend>
        <div class="mood-grid" id="mood-sogol" role="radiogroup" aria-label="انتخاب حالت سوگل">
          {SOGOL_MOODS.map(mood => (
            <button type="button" class="mood-chip" data-mood={mood.value} role="radio" aria-checked="false">
              <span class="emoji">{mood.emoji}</span>
              <span>{mood.label}</span>
            </button>
          ))}
        </div>
        <input type="hidden" name="moodSogol" id="mood-sogol-input" value={SOGOL_MOODS[0].value} />
      </fieldset>

      <div class="pt-4 border-t border-[var(--color-border)]">
        <button type="submit" class="btn btn-primary w-full py-3.5 rounded-xl focus-ring">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          ذخیره خاطره
        </button>
      </div>
    </form>
  </div>
</div>

<script type="module" src="/scripts/add-memory-modal.js"></script>

<style>
  .mood-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 430px) {
    .modal-drawer {
      max-height: 100vh;
      border-radius: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-backdrop, .modal-drawer, .mood-chip, .author-chip {
      transition: none !important;
    }
  }
</style>