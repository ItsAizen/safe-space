---
---

<section id="live-counter" class="counter-card">
  <div class="counter-orb"></div>

  <!-- Header -->
  <div class="counter-head">
    <span class="counter-live"></span>
    <span class="counter-head-label">فرکانس مشترک از ۱ شهریور ۱۴۰۵</span>
  </div>

  <!-- Hero: the endless days total -->
  <div class="counter-hero">
    <div class="counter-days">
      <span id="counter-days">۰</span>
      <small>روز</small>
    </div>
  </div>

  <!-- Hours : Minutes : Seconds -->
  <div class="counter-time">
    <div class="counter-chip">
      <span id="counter-hours">۰۰</span>
      <label>ساعت</label>
    </div>
    <span class="counter-colon">:</span>
    <div class="counter-chip">
      <span id="counter-minutes">۰۰</span>
      <label>دقیقه</label>
    </div>
    <span class="counter-colon">:</span>
    <div class="counter-chip">
      <span id="counter-seconds">۰۰</span>
      <label>ثانیه</label>
    </div>
  </div>

  <!-- Wave -->
  <div class="counter-wave">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>
  <p class="counter-foot">هر ثانیه با هم</p>
</section>

<script is:inline>
(function() {
  // 1 Shahrivar 1405 = 2026-08-23T00:00:00+03:30 (Iran time)
  var MILESTONE = new Date('2026-08-23T00:00:00+03:30').getTime();

  var daysEl = document.getElementById('counter-days');
  var hoursEl = document.getElementById('counter-hours');
  var minutesEl = document.getElementById('counter-minutes');
  var secondsEl = document.getElementById('counter-seconds');

  if (!daysEl) return;

  var prev = { h: '--', m: '--', s: '--' };

  function pad2(n) { return String(n).padStart(2, '0'); }
  function toPer(s) { return s.replace(/\d/g, function(d) { return '\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669'[d]; }); }
  function fmt(v) { return toPer(pad2(v)); }

  function tick(el, value) {
    if (el.textContent !== value) {
      el.textContent = value;
      el.classList.remove('tick');
      void el.offsetWidth; // restart animation
      el.classList.add('tick');
    }
  }

  function countUp(el, target) {
    var dur = 900;
    var t0 = performance.now();
    function step(t) {
      var p = Math.min(1, (t - t0) / dur);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = toPer(String(Math.floor(eased * target)));
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  var firstRun = true;

  function update() {
    var now = Date.now();
    var diff = now - MILESTONE;

    if (diff < 0) {
      daysEl.textContent = toPer('0');
      hoursEl.textContent = fmt(0);
      minutesEl.textContent = fmt(0);
      secondsEl.textContent = fmt(0);
      return;
    }

    var totalSeconds = Math.floor(diff / 1000);
    var days = Math.floor(totalSeconds / 86400);
    var hours = Math.floor((totalSeconds % 86400) / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    if (firstRun) {
      countUp(daysEl, days);
      hoursEl.textContent = fmt(hours);
      minutesEl.textContent = fmt(minutes);
      secondsEl.textContent = fmt(seconds);
      prev = { h: fmt(hours), m: fmt(minutes), s: fmt(seconds) };
      firstRun = false;
    } else {
      tick(hoursEl, fmt(hours));
      tick(minutesEl, fmt(minutes));
      tick(secondsEl, fmt(seconds));
    }
  }

  update();
  setInterval(update, 1000);

  // Entrance animation
  if (window.gsap) {
    var section = document.getElementById('live-counter');
    if (section) {
      gsap.from(section, {
        y: 24,
        opacity: 0,
        duration: 0.7,
        ease: 'power3.out',
        delay: 0.15,
      });
      gsap.from('.counter-days', {
        scale: 0.88,
        opacity: 0,
        duration: 0.7,
        ease: 'back.out(1.6)',
        delay: 0.35,
      });
    }
  }
})();
</script>

<style is:global>
  /* === Live Counter card === */
  .counter-card {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 20px 20px 18px;
    background: linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.018) 60%);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05),
                0 16px 40px rgba(0,0,0,0.16);
  }

  .counter-orb {
    position: absolute;
    top: -90px;
    left: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(16,185,129,0.26), transparent 70%);
    filter: blur(12px);
    pointer-events: none;
  }

  .counter-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-bottom: 16px;
  }
  .counter-head-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
  }
  .counter-live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    animation: livePulse 1.6s ease-out infinite;
  }
  @keyframes livePulse {
    0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.5); }
    70% { box-shadow: 0 0 0 10px rgba(16,185,129,0); }
    100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
  }

  /* Hero: endless days total */
  .counter-hero {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 150px;
    margin: 10px 0 18px;
  }
  .counter-hero::before {
    content: '';
    position: absolute;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(16,185,129,0.15), transparent 66%);
    pointer-events: none;
  }

  .counter-days {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .counter-days span {
    font-size: 46px;
    font-weight: 800;
    line-height: 1;
    color: #34d399;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 26px rgba(16,185,129,0.5);
  }
  .counter-days small {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.14em;
  }

  /* Time chips */
  .counter-time {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .counter-chip {
    flex: 1;
    max-width: 100px;
    padding: 12px 8px 10px;
    text-align: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
  }
  .counter-chip span {
    display: block;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    color: rgba(255,255,255,0.9);
    font-variant-numeric: tabular-nums;
  }
  .counter-chip label {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.05em;
  }
  .counter-chip span.tick {
    animation: digitTick 0.3s ease;
  }
  @keyframes digitTick {
    0% { transform: translateY(-4px); opacity: 0.4; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .counter-colon {
    align-self: center;
    font-size: 18px;
    font-weight: 700;
    color: rgba(16,185,129,0.65);
    animation: colonBlink 1s step-end infinite;
  }
  @keyframes colonBlink {
    50% { opacity: 0.35; }
  }

  /* Wave */
  .counter-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 18px;
    margin-top: 20px;
  }
  .counter-wave span {
    width: 3px;
    border-radius: 3px;
    background: linear-gradient(180deg, #34d399, #059669);
    animation: waveBar 1.1s ease-in-out infinite;
  }
  .counter-wave span:nth-child(1) { height: 45%; animation-delay: 0s; }
  .counter-wave span:nth-child(2) { height: 75%; animation-delay: 0.12s; }
  .counter-wave span:nth-child(3) { height: 55%; animation-delay: 0.24s; }
  .counter-wave span:nth-child(4) { height: 90%; animation-delay: 0.36s; }
  .counter-wave span:nth-child(5) { height: 60%; animation-delay: 0.48s; }
  .counter-wave span:nth-child(6) { height: 80%; animation-delay: 0.6s; }
  .counter-wave span:nth-child(7) { height: 40%; animation-delay: 0.72s; }
  @keyframes waveBar {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.35); }
  }

  .counter-foot {
    margin-top: 10px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.28);
  }

  /* === Light mode === */
  html.light .counter-card {
    background: linear-gradient(180deg, #ffffff, rgba(255,255,255,0.65));
    border-color: rgba(0,0,0,0.07);
    box-shadow: inset 0 1px 0 #fff,
                0 16px 40px rgba(0,0,0,0.07);
  }
  html.light .counter-head-label { color: rgba(24,24,27,0.5); }
  html.light .counter-days span {
    color: #059669;
    text-shadow: 0 0 22px rgba(16,185,129,0.3);
  }
  html.light .counter-days small { color: rgba(24,24,27,0.45); }
  html.light .counter-hero::before {
    background: radial-gradient(circle, rgba(16,185,129,0.12), transparent 66%);
  }
  html.light .counter-chip {
    background: rgba(255,255,255,0.85);
    border-color: rgba(0,0,0,0.06);
    box-shadow: inset 0 1px 0 #fff, 0 2px 10px rgba(0,0,0,0.03);
  }
  html.light .counter-chip span { color: #27272a; }
  html.light .counter-chip label { color: rgba(24,24,27,0.45); }
  html.light .counter-foot { color: rgba(24,24,27,0.4); }
  html.light .counter-orb {
    background: radial-gradient(circle, rgba(16,185,129,0.18), transparent 70%);
  }
</style>