---
const milestoneLabel = '۱ شهریور ۱۴۰۵';
---
<section id="live-counter" class="glass mx-0 mt-1 rounded-3xl p-5">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-sm font-bold text-ink">فرکانس مشترک از {milestoneLabel}</h2>
    <span
      class="flex items-center gap-1.5 rounded-full bg-surface-2 px-3 py-1 text-[11px] text-ink-soft"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-mint"></span>
      زنده
    </span>
  </div>

  <div class="grid grid-cols-4 gap-2">
    <div class="flex flex-col items-center rounded-2xl bg-surface-2 py-3">
      <span data-days class="text-2xl font-bold tabular-nums text-mint">۰</span>
      <span class="mt-1 text-[11px] text-ink-soft">روز</span>
    </div>
    <div class="flex flex-col items-center rounded-2xl bg-surface-2 py-3">
      <span data-hours class="text-2xl font-bold tabular-nums text-mint">۰۰</span>
      <span class="mt-1 text-[11px] text-ink-soft">ساعت</span>
    </div>
    <div class="flex flex-col items-center rounded-2xl bg-surface-2 py-3">
      <span data-minutes class="text-2xl font-bold tabular-nums text-mint">۰۰</span>
      <span class="mt-1 text-[11px] text-ink-soft">دقیقه</span>
    </div>
    <div class="flex flex-col items-center rounded-2xl bg-surface-2 py-3">
      <span data-seconds class="text-2xl font-bold tabular-nums text-mint">۰۰</span>
      <span class="mt-1 text-[11px] text-ink-soft">ثانیه</span>
    </div>
  </div>
</section>

<script>
  import { initLiveCounter } from '../lib/counter';
  initLiveCounter();
</script>
