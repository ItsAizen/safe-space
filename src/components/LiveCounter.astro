---

<section id="live-counter" class="counter-card">
  <div class="counter-orb"></div>
  <div class="counter-orb-2"></div>

  <!-- Header -->
  <div class="counter-head">
    <span class="counter-live"></span>
    <span class="counter-head-label">فرکانس مشترک از ۱ شهریور ۱۴۰۵</span>
    <span class="counter-live"></span>
  </div>

  <!-- Hero: the endless days total -->
  <div class="counter-hero">
    <div class="counter-days-frame">
      <div class="counter-days">
        <span id="counter-days">۰</span>
        <small>روز با هم</small>
      </div>
    </div>
  </div>

  <!-- Hours : Minutes : Seconds -->
  <div class="counter-time">
    <div class="counter-chip">
      <span id="counter-hours">۰۰</span>
      <label>ساعت</label>
    </div>
    <span class="counter-colon">:</span>
    <div class="counter-chip">
      <span id="counter-minutes">۰۰</span>
      <label>دقیقه</label>
    </div>
    <span class="counter-colon">:</span>
    <div class="counter-chip">
      <span id="counter-seconds">۰۰</span>
      <label>ثانیه</label>
    </div>
  </div>

  <!-- Wave -->
  <div class="counter-wave">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <p class="counter-foot">هر ثانیه با هم، تا ابد</p>
</section>

<script is:inline>
(function() {
  var MILESTONE = new Date('2026-08-23T00:00:00+03:30').getTime();

  var daysEl = document.getElementById('counter-days');
  var hoursEl = document.getElementById('counter-hours');
  var minutesEl = document.getElementById('counter-minutes');
  var secondsEl = document.getElementById('counter-seconds');

  if (!daysEl) return;

  function pad2(n) { return String(n).padStart(2, '0'); }
  function toPer(s) { return s.replace(/\d/g, function(d) { return '۰۱۲۳۴۵۶۷۸۹'[d]; }); }
  function fmt(v) { return toPer(pad2(v)); }

  function tick(el, value) {
    if (el.textContent !== value) {
      el.textContent = value;
      el.classList.remove('tick');
      void el.offsetWidth;
      el.classList.add('tick');
    }
  }

  function countUp(el, target) {
    var dur = 1200;
    var t0 = performance.now();
    function step(t) {
      var p = Math.min(1, (t - t0) / dur);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = toPer(String(Math.floor(eased * target)));
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  var firstRun = true;

  function update() {
    var now = Date.now();
    var diff = now - MILESTONE;

    if (diff < 0) {
      daysEl.textContent = toPer('0');
      hoursEl.textContent = fmt(0);
      minutesEl.textContent = fmt(0);
      secondsEl.textContent = fmt(0);
      return;
    }

    var totalSeconds = Math.floor(diff / 1000);
    var days = Math.floor(totalSeconds / 86400);
    var hours = Math.floor((totalSeconds % 86400) / 3600);
    var minutes = Math.floor((totalSeconds % 3600) / 60);
    var seconds = totalSeconds % 60;

    if (firstRun) {
      countUp(daysEl, days);
      hoursEl.textContent = fmt(hours);
      minutesEl.textContent = fmt(minutes);
      secondsEl.textContent = fmt(seconds);
      firstRun = false;
    } else {
      tick(hoursEl, fmt(hours));
      tick(minutesEl, fmt(minutes));
      tick(secondsEl, fmt(seconds));
    }
  }

  update();
  setInterval(update, 1000);

  if (window.gsap) {
    var section = document.getElementById('live-counter');
    if (section) {
      gsap.from(section, {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        delay: 0.15,
      });
      gsap.from('.counter-days-frame', {
        scale: 0.8,
        opacity: 0,
        duration: 0.9,
        ease: 'back.out(1.4)',
        delay: 0.4,
      });
      gsap.from('.counter-chip', {
        y: 20,
        opacity: 0,
        duration: 0.5,
        stagger: 0.1,
        ease: 'power2.out',
        delay: 0.6,
      });
    }
  }
})();
</script>

<style is:global>
  .counter-card {
    position: relative;
    overflow: hidden;
    padding: 24px 20px 20px;
    background: linear-gradient(180deg, rgba(26,21,48,0.95), rgba(19,16,42,0.98) 60%);
    border: 3px solid rgba(255,255,255,0.08);
    box-shadow: 4px 4px 0px rgba(0,0,0,0.35),
                inset 0 1px 0 rgba(255,255,255,0.05),
                0 0 40px rgba(190,24,93,0.06);
  }

  .counter-orb {
    position: absolute;
    top: -80px;
    left: -60px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(190,24,93,0.2), transparent 70%);
    filter: blur(15px);
    pointer-events: none;
  }

  .counter-orb-2 {
    position: absolute;
    bottom: -60px;
    right: -40px;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124,58,237,0.15), transparent 70%);
    filter: blur(15px);
    pointer-events: none;
  }

  .counter-head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-bottom: 12px;
  }
  .counter-head-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.45);
  }
  .counter-live {
    width: 6px;
    height: 6px;
    background: #f472b6;
    animation: livePulse 1.6s ease-out infinite;
  }
  @keyframes livePulse {
    0% { box-shadow: 0 0 0 0 rgba(244,114,182,0.5); }
    70% { box-shadow: 0 0 0 8px rgba(244,114,182,0); }
    100% { box-shadow: 0 0 0 0 rgba(244,114,182,0); }
  }

  .counter-hero {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 140px;
    margin: 8px 0 16px;
  }

  .counter-days-frame {
    position: relative;
    z-index: 1;
    padding: 16px 28px;
    border: 2px solid rgba(244,114,182,0.15);
    box-shadow: 4px 4px 0px rgba(0,0,0,0.25),
                inset 0 0 30px rgba(244,114,182,0.04),
                0 0 30px rgba(244,114,182,0.06);
    animation: counterGlow 3s ease-in-out infinite;
  }
  @keyframes counterGlow {
    0%, 100% {
      box-shadow: 4px 4px 0px rgba(0,0,0,0.25),
                  inset 0 0 30px rgba(244,114,182,0.04),
                  0 0 25px rgba(244,114,182,0.04);
    }
    50% {
      box-shadow: 4px 4px 0px rgba(0,0,0,0.25),
                  inset 0 0 40px rgba(244,114,182,0.06),
                  0 0 45px rgba(244,114,182,0.08);
    }
  }

  .counter-days {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .counter-days span {
    font-size: 52px;
    font-weight: 800;
    line-height: 1;
    color: #f472b6;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 0 30px rgba(244,114,182,0.4),
                 0 0 60px rgba(244,114,182,0.15);
  }
  .counter-days small {
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.14em;
  }

  .counter-time {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .counter-chip {
    flex: 1;
    max-width: 95px;
    padding: 12px 6px 10px;
    text-align: center;
    background: rgba(255,255,255,0.04);
    border: 2px solid rgba(255,255,255,0.07);
    box-shadow: 2px 2px 0px rgba(0,0,0,0.25);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .counter-chip:hover {
    border-color: rgba(244,114,182,0.25);
    box-shadow: 2px 2px 0px rgba(0,0,0,0.25), 0 0 12px rgba(244,114,182,0.06);
  }
  .counter-chip span {
    display: block;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    color: rgba(255,255,255,0.9);
    font-variant-numeric: tabular-nums;
  }
  .counter-chip label {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.05em;
  }
  .counter-chip span.tick {
    animation: digitTick 0.3s ease;
  }
  @keyframes digitTick {
    0% { transform: translateY(-4px); opacity: 0.4; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .counter-colon {
    align-self: center;
    font-size: 18px;
    font-weight: 700;
    color: rgba(244,114,182,0.65);
    animation: colonBlink 1s step-end infinite;
  }
  @keyframes colonBlink {
    50% { opacity: 0.35; }
  }

  .counter-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 20px;
    margin-top: 18px;
  }
  .counter-wave span {
    width: 3px;
    border-radius: 0;
    background: linear-gradient(180deg, #f472b6, #be185d);
    animation: waveBar 1.1s ease-in-out infinite;
  }
  .counter-wave span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .counter-wave span:nth-child(2) { height: 65%; animation-delay: 0.1s; }
  .counter-wave span:nth-child(3) { height: 50%; animation-delay: 0.2s; }
  .counter-wave span:nth-child(4) { height: 80%; animation-delay: 0.3s; }
  .counter-wave span:nth-child(5) { height: 55%; animation-delay: 0.4s; }
  .counter-wave span:nth-child(6) { height: 70%; animation-delay: 0.5s; }
  .counter-wave span:nth-child(7) { height: 45%; animation-delay: 0.6s; }
  @keyframes waveBar {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.35); }
  }

  .counter-foot {
    margin-top: 10px;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.28);
  }
</style>
